; #GLOBALS - STAFF PATTERNS# ====================================================================================================
; Name...........: $GC_AS2_STAFF_PATTERNS
; Description....: Staff patterns keyed by attribute. Column 0 is the **attribute id**, columns 1..N are mod tokens.
;                  Each row states: “for this attribute, accept any item whose mods satisfy these Pos/Neg tokens”.
; Shape..........: 2D array, rows like: [ Attr, Mod1, Mod2, ... ]
;                  Example: [ 10, "FIRE_20_CASTING", "FIRE_20_RECHARGE" ] or [ 10, "FIRE_20_CASTING", "15ALWAYS", "E_REG" ]
; Used by........: ItemFilter_InitStaffEntries() → $g_m_StaffEntriesByAttr[attr] = array of [Pos[],Neg[]].
; Related........: ItemFilter_RowToEntry, ItemFilter_AnyEntryMatch, Item_GetItemAttribute
; ===============================================================================================================================
Global Const $GC_AS2_STAFF_PATTERNS = [ _
    [$GC_I_ATTRIBUTE_FAST_CASTING, $GC_S_MOD_STAFF_FAST_CASTING20_CASTING], _
	[$GC_I_ATTRIBUTE_FAST_CASTING, $GC_S_MOD_STAFF_ILLUSION20_CASTING], _
	[$GC_I_ATTRIBUTE_FAST_CASTING, $GC_S_MOD_STAFF_DOMINATION20_CASTING], _
	[$GC_I_ATTRIBUTE_FAST_CASTING, $GC_S_MOD_STAFF_INSPIRATION20_CASTING], _
	[$GC_I_ATTRIBUTE_ILLUSION_MAGIC, $GC_S_MOD_STAFF_ILLUSION20_CASTING], _
	[$GC_I_ATTRIBUTE_DOMINATION_MAGIC, $GC_S_MOD_STAFF_DOMINATION20_CASTING], _
