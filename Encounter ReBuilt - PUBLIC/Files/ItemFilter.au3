			$GC_I_MODELID_FROG_SCEPTER_PROTECTION_PRAYERS, _
			$GC_I_MODELID_FROG_SCEPTER_SMITING_PRAYERS, _
			$GC_I_MODELID_FROG_SCEPTER_COMMUNING, _
			$GC_I_MODELID_FROG_SCEPTER_SPAWNING_POWER, _
			$GC_I_MODELID_FROG_SCEPTER_RESTORATION_MAGIC, _
			$GC_I_MODELID_FROG_SCEPTER_CHANNELING_MAGIC, _
			$GC_I_MODELID_DRYAD_BOW, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_DOMINATION_MAGIC, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_FAST_CASTING, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_ILLUSION_MAGIC, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_INSPIRATION_MAGIC, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_SOUL_REAPING, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_BLOOD_MAGIC, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_CURSES, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_DEATH_MAGIC, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_AIR_MAGIC, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_EARTH_MAGIC, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_ENERGY_STORAGE, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_FIRE_MAGIC, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_WATER_MAGIC, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_DIVINE_FAVOR, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_HEALING_PRAYERS, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_PROTECTION_PRAYERS, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_SMITING_PRAYERS, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_COMMUNING, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_SPAWNING, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_RESTORATION_MAGIC, _
			$GC_I_MODELID_BONE_DRAGON_STAFF_CHANNELING_MAGIC, _
			$GC_I_MODELID_SILVERWING_RECURVEBOW, _
			$GC_I_MODELID_BONECAGE_SCYTHE, _
			$GC_I_MODELID_CRESCENT_STAFF, _
			$GC_I_MODELID_PLATINUM_BROADSWORD, _
			$GC_I_MODELID_ENAMELED_SHIELD, _
			$GC_I_MODELID_DARKWING_DEFENDER_TACTICS, _
			$GC_I_MODELID_COLOSSAL_SCIMITAR, _
			$GC_I_MODELID_GLOOM_SHIELD_STRENGTH, _
			$GC_I_MODELID_GLOOM_SHIELD_TACTICS, _
			$GC_I_MODELID_CELESTIAL_SHIELD, _
			$GC_I_MODELID_ICICLE_STAFF_1, _
			$GC_I_MODELID_ICICLE_STAFF_2, _
			$GC_I_MODELID_ICICLE_STAFF_3, _
			$GC_I_MODELID_ICICLE_STAFF_4, _
			$GC_I_MODELID_ICICLE_STAFF_5, _
			$GC_I_MODELID_AMETHYST_SHIELD_MOTIVATION, _
			$GC_I_MODELID_AMETHYST_SHIELD_COMMAND, _
			$GC_I_MODELID_AMETHYST_SHIELD_TACTICS, _
			$GC_I_MODELID_MAGMAS_SHIELD _
		]

		For $i = 0 To UBound($l_ai_RareSkins_AnniversaryTyria) - 1
			$s_m_RareSkins[$l_ai_RareSkins_AnniversaryTyria[$i]] = True
		Next
		For $i = 0 To UBound($l_ai_RareSkins_AnniversaryCantha) - 1
			$s_m_RareSkins[$l_ai_RareSkins_AnniversaryCantha[$i]] = True
		Next
		For $i = 0 To UBound($l_ai_RareSkins_AnniversaryElona) - 1
			$s_m_RareSkins[$l_ai_RareSkins_AnniversaryElona[$i]] = True
		Next
		For $i = 0 To UBound($l_ai_RareSkins_AnniversaryEotN) - 1
			$s_m_RareSkins[$l_ai_RareSkins_AnniversaryEotN[$i]] = True
		Next
		For $i = 0 To UBound($l_ai_RareSkins_AnniversaryCore) - 1
			$s_m_RareSkins[$l_ai_RareSkins_AnniversaryCore[$i]] = True
		Next
		For $i = 0 To UBound($l_ai_RareSkins_General) - 1
			$s_m_RareSkins[$l_ai_RareSkins_General[$i]] = True
		Next

        $s_b_Init = True
    EndIf

	Return MapExists($s_m_RareSkins, $a_i_ModelID) <> 0
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_CanSellToMerchant_OS
; Description....: High-level policy that decides whether an item can be sold to a merchant, based on type, req/max,
;                  rare skins, perfect mod patterns, and salvageable rune.
; Syntax.........: ItemFilter_CanSellToMerchant_OS ( $a_p_Item [, $a_i_Type = -1 [, $a_i_ModelID = -1 [, $a_i_Value = -1 ]]] )
; Parameters.....: $a_p_Item         - Pointer to item struct (0 is invalid).
;                  $a_i_Type         - Optional weapon type byte; when -1 it is read from the item (offset +0x20).
;                  $a_i_ModelID      - Optional ModelID; when -1 it is read from the item (offset +0x2C).
;                  $a_i_Value        - Optional vendor value; when -1 it is read from the item (offset +0x24).
; Return values..: Success           - True if policy allows selling to merchant; otherwise False.
;                  Failure           - False with @error set:
;                                      @error = 1 → invalid item pointer
; Author.........: KleuTSchi
; Remarks........: - Weapons (OS): rare-skin items are kept unless they lack perfect mods. For req > 9 → sell.
;                    For req = 9 → sell if not perfect; for req = 8/7 → sell if not max-for-req OR not perfect; else
;                    sell if vendor value is non-zero (prevents cases of trying to sell unsellable weapons).
;                  - Salvage / Rune types: sell unless ItemFilter_IsRareRune() detects a rare rune.
;                  - Other types default to False (do not sell).
; Related........: ItemFilter_IsRareSkin, ItemFilter_HasPerfectMods, ItemFilter_IsMaxReq7, ItemFilter_IsMaxReq8,
;                  Item_GetItemReq, Item_GetItemMaxDmg, Item_GetModStruct
; ===============================================================================================================================
Func ItemFilter_CanSellToMerchant_OS($a_p_Item, $a_i_Type = -1, $a_i_ModelID = -1, $a_i_Value = -1)
    If $a_p_Item = 0 Then Return SetError(1, 0, False)
    If $a_i_Type = -1 Then $a_i_Type = Memory_Read($a_p_Item + 0x20, "byte")
	If $a_i_Value = -1 Then $a_i_Value = Memory_Read($a_p_Item + 0x24, "short")
	If $a_i_Value <= 0 Then Return False

	Switch $a_i_Type
		Case $GC_I_TYPE_OFFHAND, $GC_I_TYPE_SHIELD
			If $a_i_ModelID = -1 Then $a_i_ModelID = Memory_Read($a_p_Item + 0x2C, "dword")

			If ItemFilter_IsRareSkin($a_i_ModelID) Then
				Return Not ItemFilter_HasPerfectMods($a_p_Item, $a_i_Type)
			EndIf

			Local $l_i_Req = Item_GetItemReq($a_p_Item)
			If $l_i_Req > 9 Then Return True

			Switch $l_i_Req
                Case 9
                    Return Not ItemFilter_HasPerfectMods($a_p_Item, $a_i_Type)
                Case 8
                    Return Not (ItemFilter_IsMaxReq8($a_p_Item, $a_i_Type) And ItemFilter_HasPerfectMods($a_p_Item, $a_i_Type))
                Case 7
                    Return Not (ItemFilter_IsMaxReq7($a_p_Item, $a_i_Type) And ItemFilter_HasPerfectMods($a_p_Item, $a_i_Type))
                Case Else
                    Return True
            EndSwitch

		Case $GC_I_TYPE_WAND
			If $a_i_ModelID = -1 Then $a_i_ModelID = Memory_Read($a_p_Item + 0x2C, "dword")

			If ItemFilter_IsRareSkin($a_i_ModelID) Then
				Return Not ItemFilter_HasPerfectMods($a_p_Item, $a_i_Type)
			EndIf

			Local $l_i_Req = Item_GetItemReq($a_p_Item)
			If $l_i_Req > 9 Then Return True

			Return Not ItemFilter_HasPerfectMods($a_p_Item, $a_i_Type)

		Case $GC_I_TYPE_STAFF
			If $a_i_ModelID = -1 Then $a_i_ModelID = Memory_Read($a_p_Item + 0x2C, "dword")

			Local $l_i_Req = Item_GetItemReq($a_p_Item)
			If $l_i_Req > 9 Then Return True

			Return Not (ItemFilter_IsRareSkin($a_i_ModelID) And ItemFilter_HasPerfectMods($a_p_Item, $a_i_Type))

		Case $GC_I_TYPE_AXE, $GC_I_TYPE_BOW, $GC_I_TYPE_HAMMER, $GC_I_TYPE_SWORD, $GC_I_TYPE_DAGGERS, $GC_I_TYPE_SCYTHE, $GC_I_TYPE_SPEAR
			If $a_i_ModelID = -1 Then $a_i_ModelID = Memory_Read($a_p_Item + 0x2C, "dword")

			Local $l_i_Req = Item_GetItemReq($a_p_Item)
			If $l_i_Req > 9 Then Return True

			Switch $l_i_Req
				Case 9
					Return Not (ItemFilter_IsRareSkin($a_i_ModelID) And ItemFilter_HasPerfectMods($a_p_Item, $a_i_Type))
				Case 8
					Local $l_b_IsMax8 = ItemFilter_IsMaxReq8($a_p_Item, $a_i_Type)
					If $l_b_IsMax8 Then
						Return Not ItemFilter_HasPerfectMods($a_p_Item, $a_i_Type)
					EndIf
					Return True
				Case 7
					Local $l_b_IsMax7 = ItemFilter_IsMaxReq7($a_p_Item, $a_i_Type)
					If $l_b_IsMax7 Then
						Return Not ItemFilter_HasPerfectMods($a_p_Item, $a_i_Type)
					EndIf
					Return True
				Case Else
					Return True
			EndSwitch

		Case $GC_I_TYPE_SALVAGE, $GC_I_TYPE_RUNE_AND_MOD
			If ItemFilter_IsRareRune($a_p_Item) Then Return SetExtended($a_p_Item, False)
			Return True

		Case Else
			Return False
	EndSwitch
EndFunc
#Region ItemFilter