#include-once

#Region ModPatterns
; #GLOBALS - ITEMFILTER PATTERN CONFIGURATION# ==================================================================================
; These constants are **authoritative configuration tables** that drive the ItemFilter pipeline.
; They are consumed by ItemFilter_InitPatterns(), which compiles them into fast lookup structures.
; Notes for all pattern arrays:
;   * AutoIt stores 2D “jagged” declarations as rectangular arrays; shorter rows are padded with "" (empty strings).
;     The runtime helpers only read cells until the first empty token per row (ItemFilter_RowToEntry / ItemFilter_RowLen).
;   * Tokens are compared in a *normalized* form (ItemFilter_NormalizeMod → StringUpper).
;   * A leading '-' in a token means “this mod must NOT be present” (negative token).
;     Example: ["+15%_FLAT", "VAMP", "-MINUS10_ARMOR", "-MINUS5_ENERGY"] → Pos=["+15%_FLAT","VAMP"], Neg=["MINUS10_ARMOR","MINUS5_ENERGY"].
;   * Do not put raw empty tokens in the *middle* of a row; an empty cell terminates scanning for that row.
;   * Keep tokens unique and consistent with $GC_AS_ALL_WEAPON_MODS. If two tokens can be substrings of each other,
;     the parser mitigates by length-sorting the alternation regex, but unique tokens are still recommended.
; ===============================================================================================================================

; #GLOBALS - MARTIAL PATTERNS# ==================================================================================================
; Name...........: $GC_AS2_MARTIAL_PATTERNS
; Description....: Martial weapon patterns (Axe/Bow/Hammer/Sword/Daggers/Scythe/Spear).
;                  Each row encodes one acceptable “perfect mod” recipe as a list of tokens.
;                  Negatives (with '-') are allowed to explicitly forbid inherent or rolled traits.
; Shape..........: 2D array, rows are mod lists, e.g.
;                  [ ["+15%_VS50"], ["+15%_ENCH"], ["+15%_STANCE"], ["+5E"],
;                    ["+15%_FLAT","VAMP","-MINUS10_ARMOR","-MINUS5_ENERGY"],
;                    ["+15%_FLAT","ZEAL","-MINUS10_ARMOR","-MINUS5_ENERGY"] ]
; Used by........: ItemFilter_InitMartialEntries() → $g_as_MartialEntries (array of [Pos[],Neg[]]).
; Related........: ItemFilter_RowToEntry, ItemFilter_AnyEntryMatch
; ===============================================================================================================================
Global Const $GC_AS2_MARTIAL_PATTERNS = [ _
    _ ;~ [$GC_S_MOD_MARTIAL_PLUS1550], _
    _ ;~ [$GC_S_MOD_MARTIAL_PLUS15_ENCH], _
    _ ;~ [$GC_S_MOD_MARTIAL_PLUS15_STANCE], _
    _ ;~ [$GC_S_MOD_MARTIAL_PLUS5_ENERGY], _
	_ ;~ [$GC_S_MOD_MARTIAL_PLUS15_FLAT, $GC_S_MOD_MARTIAL_MINUS5_ENERGY], _
    [$GC_S_MOD_MARTIAL_PLUS15_FLAT, $GC_S_MOD_MARTIAL_VAMP, "-" & $GC_S_MOD_MARTIAL_MINUS10_ARMOR, "-" & $GC_S_MOD_MARTIAL_MINUS5_ENERGY], _
    [$GC_S_MOD_MARTIAL_PLUS15_FLAT, $GC_S_MOD_MARTIAL_ZEAL, "-" & $GC_S_MOD_MARTIAL_MINUS10_ARMOR, "-" & $GC_S_MOD_MARTIAL_MINUS5_ENERGY] _
]

; #GLOBALS - SHIELD PATTERNS# ===================================================================================================
; Name...........: $GC_AS2_SHIELD_PATTERNS
; Description....: Shield patterns. Each row is a list of required/forbidden shield mods.
;                  Typical rows are size 2, but you can add more tokens if desired.
; Shape..........: 2D array, rows are mod lists, e.g.
;                  [ ["+30_HP","-3_HEX"], ["+30_HP","-2_STANCE"], ["+30_HP","-2_ENCH"], ["+30_HP","-5(20)"] ]
; Used by........: ItemFilter_InitShieldEntries() → $g_as_ShieldEntries (array of [Pos[],Neg[]]).
; Related........: ItemFilter_RowToEntry, ItemFilter_AnyEntryMatch
; ===============================================================================================================================
