	[$GC_I_ATTRIBUTE_DEATH_MAGIC, $GC_S_MOD_STAFF_DEATH20_CASTING], _
	[$GC_I_ATTRIBUTE_SOUL_REAPING, $GC_S_MOD_STAFF_BLOOD20_CASTING], _
