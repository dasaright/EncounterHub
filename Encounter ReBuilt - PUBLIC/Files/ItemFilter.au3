; ===============================================================================================================================
#EndRegion RareSkins

#Region ItemFilter
; #GLOBALS - ITEMFILTER (BUILT STRUCTURES)# =====================================================================================
; Core lookup structures built once at startup by ItemFilter_InitPatterns(). These are read-only at runtime.
; Each pattern “entry” is a 2-element array: [ PosMods[], NegMods[] ] where
;   - PosMods[] = all tokens that MUST be present on the item
;   - NegMods[] = all tokens that MUST NOT be present on the item
; ===============================================================================================================================
Global $g_m_AllMods[]				; Map (set): token → True. All normalized mod tokens (authoritative universe).
Global $g_s_AllModsRegex = ""		; Single alternation regex built from $g_m_AllMods (e.g. "(MOD_A|MOD_B|...)") for fast parsing.
Global $g_as_MartialEntries[0]		; Array of entries for martial weapons: [ [Pos[],Neg[]], ... ].
Global $g_as_ShieldEntries[0]		; Array of entries for shields: [ [Pos[],Neg[]], ... ].
Global $g_m_StaffEntriesByAttr[]	; Map: attr → array of entries [ [Pos[],Neg[]], ... ] (staffs are gated by attribute).
Global $g_m_CasterEntriesByAttr[]	; Map: attr → array of entries [ [Pos[],Neg[]], ... ] (wands/offhands gated by attribute).
; ===============================================================================================================================

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_NormalizeMod
; Description....: Canonicalizes a mod token to a normalized form for stable comparisons.
; Syntax.........: ItemFilter_NormalizeMod ( $a_s_Mod )
; Parameters.....: $a_s_Mod          - Mod token string as read or configured.
; Return values..: Success           - Normalized token (currently uppercased).
; Author.........: KleuTSchi
; Remarks........: Normalization is centralized here so future changes (e.g., trimming, aliasing) are one-line.
; Related........: ItemFilter_ParseModsFromStruct, ItemFilter_RowToEntry
; ===============================================================================================================================
Func ItemFilter_NormalizeMod($a_s_Mod)
    Return StringUpper($a_s_Mod)
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_RowLen
; Description....: Counts non-empty cells in a “row” of a rectangular (padded) 2D array from a start index to the right.
; Syntax.........: ItemFilter_RowLen ( $a_amx2_Parent, $a_i_Row, $a_i_StartIdx )
; Parameters.....: $a_amx2_Parent    - 2D pattern array (rectangular due to AutoIt’s padding).
;                  $a_i_Row          - Row index to inspect.
;                  $a_i_StartIdx     - Column index to start counting (inclusive).
; Return values..: Success           - Integer count of consecutive non-empty tokens.
;                  Edge case         - 0 when $a_i_StartIdx is l_as_Mods of range or next cell is empty.
; Author.........: KleuTSchi
; Remarks........: AutoIt pads jagged declarations; this helper finds the true logical length of a row segment.
; Related........: ItemFilter_RowToEntry, UBound
; ===============================================================================================================================
Func ItemFilter_RowLen($a_amx2_Parent, $a_i_Row, $a_i_StartIdx)
    Local $l_i_Cols = UBound($a_amx2_Parent, $UBOUND_COLUMNS)
    If $a_i_StartIdx >= $l_i_Cols Then Return 0
    Local $l_i_Cnt = 0
    For $i = $a_i_StartIdx To $l_i_Cols - 1
        Local $l_s_Token = $a_amx2_Parent[$a_i_Row][$i]
        If $l_s_Token = "" Then ExitLoop
        $l_i_Cnt += 1
    Next
    Return $l_i_Cnt
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_RowToEntry
; Description....: Converts one logical row segment into an entry [Pos[], Neg[]]. A leading '-' marks a forbidden mod.
; Syntax.........: ItemFilter_RowToEntry ( $a_amx2_Parent, $a_i_Row, $a_i_StartIdx )
; Parameters.....: $a_amx2_Parent    - 2D pattern array.
;                  $a_i_Row          - Row index to transform.
;                  $a_i_StartIdx     - First column that belongs to mods in this row (0 for shields/martials, 1 for attr+mods).
; Return values..: Success           - 2-element array: [PosTokens[], NegTokens[]], both arrays normalized.
; Author.........: KleuTSchi
; Remarks........: Empty cells terminate scanning. Tokens are normalized via ItemFilter_NormalizeMod().
; Related........: ItemFilter_RowLen, ItemFilter_EntryMatch
; ===============================================================================================================================
Func ItemFilter_RowToEntry($a_amx2_Parent, $a_i_Row, $a_i_StartIdx)
    Local $l_i_Cols = UBound($a_amx2_Parent, $UBOUND_COLUMNS)
    Local $l_as_Pos[0], $l_as_Neg[0]
    For $j = $a_i_StartIdx To $l_i_Cols - 1
        Local $l_s_Token = $a_amx2_Parent[$a_i_Row][$j]
        If $l_s_Token = "" Then ExitLoop
        $l_s_Token = ItemFilter_NormalizeMod($l_s_Token)
        If StringLeft($l_s_Token, 1) = "-" Then
            $l_s_Token = StringTrimLeft($l_s_Token, 1)
            If $l_s_Token <> "" Then
                ReDim $l_as_Neg[UBound($l_as_Neg) + 1]
                $l_as_Neg[UBound($l_as_Neg) - 1] = $l_s_Token
            EndIf
        Else
            ReDim $l_as_Pos[UBound($l_as_Pos) + 1]
            $l_as_Pos[UBound($l_as_Pos) - 1] = $l_s_Token
        EndIf
    Next
    Local $l_as_Entry[2] = [$l_as_Pos, $l_as_Neg]
    Return $l_as_Entry
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_InitAllMods
; Description....: Builds the global token set and compiled alternation regex used by the ItemFilter parser.
;                  Consumes $GC_AS_ALL_WEAPON_MODS (authoritative list of every mod token), normalizes them,
;                  stores them in a map for O(1) membership checks, and compiles a single regex for fallback scans.
; Syntax.........: ItemFilter_InitAllMods ( )
; Parameters.....: None
; Return values..: None
; Author.........: KleuTSchi
; Remarks........: - Input: $GC_AS_ALL_WEAPON_MODS must be a 1D array of *all* mod tokens (strings).
;                  - Normalization: tokens are uppercased for canonical matching.
;                  - Outputs:
;                        * $g_m_AllMods      → Map (token → True) for fast membership tests in hot paths.
;                        * $g_s_AllModsRegex → "(TOKA|TOKB|...)" alternation built from all tokens.
;                  - Tokens are length-sorted (desc) before regex construction to reduce accidental partial matches
;                    should any future tokens overlap (e.g., "ABCD" vs "ABCD00FF").
;                  - Complexity: O(N) to normalize and stage tokens + O(N²) for the simple length-sort (N is small).
; Related........: ItemFilter_ParseModsFromStruct, ItemFilter_NormalizeMod, _ArrayToString, UBound, $g_m_AllMods, $g_s_AllModsRegex
; ===============================================================================================================================
Func ItemFilter_InitAllMods()
    Local $l_m_Set[]
    Local $l_i_Cnt = UBound($GC_AS_ALL_WEAPON_MODS)
    Local $l_as_Tokens[$l_i_Cnt]

    For $i = 0 To $l_i_Cnt - 1
        Local $l_s_Token = ItemFilter_NormalizeMod($GC_AS_ALL_WEAPON_MODS[$i])
        $l_as_Tokens[$i] = $l_s_Token
        $l_m_Set[$l_s_Token] = True
    Next

    For $i = 0 To $l_i_Cnt - 2
        For $j = $i + 1 To $l_i_Cnt - 1
            If StringLen($l_as_Tokens[$j]) > StringLen($l_as_Tokens[$i]) Then
                Local $l_s_Tmp = $l_as_Tokens[$i]
                $l_as_Tokens[$i] = $l_as_Tokens[$j]
                $l_as_Tokens[$j] = $l_s_Tmp
            EndIf
        Next
    Next

    $g_m_AllMods = $l_m_Set
    $g_s_AllModsRegex = "(" & _ArrayToString($l_as_Tokens, "|") & ")"
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_InitMartialEntries
; Description....: Translates $GC_AS2_MARTIAL_PATTERNS into $g_as_MartialEntries (array of [Pos[],Neg[]]).
; Syntax.........: ItemFilter_InitMartialEntries ( )
; Parameters.....: None
; Return values..: None
; Author.........: KleuTSchi
; Remarks........: Skips rows that resolve to empty Pos[]; each row may include negatives using the '-' prefix.
; Related........: ItemFilter_RowToEntry, $g_as_MartialEntries
; ===============================================================================================================================
Func ItemFilter_InitMartialEntries()
    Local $l_as_MartialEntries[0]
    For $i = 0 To UBound($GC_AS2_MARTIAL_PATTERNS, $UBOUND_ROWS) - 1
        Local $l_as_Entry = ItemFilter_RowToEntry($GC_AS2_MARTIAL_PATTERNS, $i, 0)
        If UBound($l_as_Entry[0]) = 0 Then ContinueLoop
        ReDim $l_as_MartialEntries[UBound($l_as_MartialEntries) + 1]
        $l_as_MartialEntries[UBound($l_as_MartialEntries) - 1] = $l_as_Entry
    Next
    $g_as_MartialEntries = $l_as_MartialEntries
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_InitShieldEntries
; Description....: Translates $GC_AS2_SHIELD_PATTERNS into $g_as_ShieldEntries (array of [Pos[],Neg[]]).
; Syntax.........: ItemFilter_InitShieldEntries ( )
; Parameters.....: None
; Return values..: None
; Author.........: KleuTSchi
; Remarks........: See ItemFilter_InitMartialEntries; shield rows are mod-only (no attribute column).
; Related........: ItemFilter_RowToEntry, $g_as_ShieldEntries
; ===============================================================================================================================
Func ItemFilter_InitShieldEntries()
    Local $l_as_ShieldEntries[0]
    For $i = 0 To UBound($GC_AS2_SHIELD_PATTERNS, $UBOUND_ROWS) - 1
        Local $l_as_Entry = ItemFilter_RowToEntry($GC_AS2_SHIELD_PATTERNS, $i, 0)
        If UBound($l_as_Entry[0]) = 0 Then ContinueLoop
        ReDim $l_as_ShieldEntries[UBound($l_as_ShieldEntries) + 1]
        $l_as_ShieldEntries[UBound($l_as_ShieldEntries) - 1] = $l_as_Entry
    Next
    $g_as_ShieldEntries = $l_as_ShieldEntries
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_InitStaffEntries
; Description....: Translates $GC_AS2_STAFF_PATTERNS (attr + mods) into $g_m_StaffEntriesByAttr.
; Syntax.........: ItemFilter_InitStaffEntries ( )
; Parameters.....: None
; Return values..: None
; Author.........: KleuTSchi
; Remarks........: Builds a map: attr → array of entries [Pos[],Neg[]]. Mods begin at column index 1.
; Related........: ItemFilter_RowToEntry, $g_m_StaffEntriesByAttr
; ===============================================================================================================================
Func ItemFilter_InitStaffEntries()
    Local $l_m_StaffEntries[]
    For $i = 0 To UBound($GC_AS2_STAFF_PATTERNS, $UBOUND_ROWS) - 1
        Local $l_i_Attr = $GC_AS2_STAFF_PATTERNS[$i][0]
        Local $l_as_Entry = ItemFilter_RowToEntry($GC_AS2_STAFF_PATTERNS, $i, 1)
        If UBound($l_as_Entry[0]) = 0 Then ContinueLoop
        If Not MapExists($l_m_StaffEntries, $l_i_Attr) Then
            Local $l_as_Arr[0]
			$l_m_StaffEntries[$l_i_Attr] = $l_as_Arr
        EndIf
        Local $l_as_Arr = $l_m_StaffEntries[$l_i_Attr]
        ReDim $l_as_Arr[UBound($l_as_Arr) + 1]
        $l_as_Arr[UBound($l_as_Arr) - 1] = $l_as_Entry
        $l_m_StaffEntries[$l_i_Attr] = $l_as_Arr
    Next
    $g_m_StaffEntriesByAttr = $l_m_StaffEntries
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_InitCasterEntries
; Description....: Translates $GC_AS2_CASTER_PATTERNS (attr + mods) into $g_m_CasterEntriesByAttr.
; Syntax.........: ItemFilter_InitCasterEntries ( )
; Parameters.....: None
; Return values..: None
; Author.........: KleuTSchi
; Remarks........: Same structure as staffs: attr → [ [Pos[],Neg[]], ... ].
; Related........: ItemFilter_RowToEntry, $g_m_CasterEntriesByAttr
; ===============================================================================================================================
Func ItemFilter_InitCasterEntries()
    Local $l_m_CasterEntries[]
    For $i = 0 To UBound($GC_AS2_CASTER_PATTERNS, $UBOUND_ROWS) - 1
        Local $l_i_Attr = $GC_AS2_CASTER_PATTERNS[$i][0]
        Local $l_as_Entry = ItemFilter_RowToEntry($GC_AS2_CASTER_PATTERNS, $i, 1)
        If UBound($l_as_Entry[0]) = 0 Then ContinueLoop
        If Not MapExists($l_m_CasterEntries, $l_i_Attr) Then
            Local $l_as_Arr[0]
			$l_m_CasterEntries[$l_i_Attr] = $l_as_Arr
        EndIf
        Local $l_as_Arr = $l_m_CasterEntries[$l_i_Attr]
        ReDim $l_as_Arr[UBound($l_as_Arr) + 1]
        $l_as_Arr[UBound($l_as_Arr) - 1] = $l_as_Entry
        $l_m_CasterEntries[$l_i_Attr] = $l_as_Arr
    Next
    $g_m_CasterEntriesByAttr = $l_m_CasterEntries
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_InitPatterns
; Description....: One-shot initializer that builds all global lookup structures for the ItemFilter.
; Syntax.........: ItemFilter_InitPatterns ( )
; Parameters.....: None
; Return values..: None
; Author.........: KleuTSchi
; Remarks........: Uses a static guard to run once per process. Calls InitAllMods + per-family initializers.
; Related........: ItemFilter_InitAllMods, ItemFilter_InitMartialEntries, ItemFilter_InitShieldEntries,
;                  ItemFilter_InitStaffEntries, ItemFilter_InitCasterEntries
; ===============================================================================================================================
Func ItemFilter_InitPatterns()
    Static $s_b_Init = False
    If $s_b_Init Then Return

    ItemFilter_InitAllMods()
	ItemFilter_InitMartialEntries()
	ItemFilter_InitShieldEntries()
	ItemFilter_InitStaffEntries()
	ItemFilter_InitCasterEntries()

	$s_b_Init = True
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_ParseModsFromStruct
; Description....: Extracts distinct, normalized mod tokens from an item’s ModStruct.
;                  Uses a fast 8-hex chunk scan when the payload length is a multiple of 8;
;                  otherwise falls back to a compiled regex ($g_s_AllModsRegex) to recover tokens.
; Syntax.........: ItemFilter_ParseModsFromStruct ( $a_s_ModStruct )
; Parameters.....: $a_s_ModStruct    - Raw ModStruct string, with or without "0x" prefix (case-insensitive).
;                                        Expected layout is a concatenation of 8-hex tokens (e.g., "AABBCCDD...").
; Return values..: Success           - 1D array of normalized (uppercased) tokens in order of first appearance, no duplicates.
;                  Edge case         - [] when input is empty or no known tokens are found.
; Author.........: KleuTSchi
; Remarks........: - Requires ItemFilter_InitAllMods() beforehand to populate $g_m_AllMods and $g_s_AllModsRegex.
;                  - Fast path: when StringLen(ModStruct) % 8 == 0, scans 8-char chunks and accepts those present in $g_m_AllMods.
;                  - Fallback: when payload is not 8-aligned (or fast path yields none), runs StringRegExp with $g_s_AllModsRegex.
;                  - Deduplication is done via a small local set; result order reflects first appearance in the ModStruct.
;                  - Does not set @error; returns an empty array for all non-match scenarios.
; Related........: ItemFilter_InitAllMods, ItemFilter_NormalizeMod, ItemFilter_ArrayToSet, MapExists, StringRegExp
; ===============================================================================================================================
Func ItemFilter_ParseModsFromStruct($a_s_ModStruct)
    Local $l_as_Mods[0]
    If $a_s_ModStruct = "" Then Return $l_as_Mods

    $a_s_ModStruct = StringTrimLeft(ItemFilter_NormalizeMod($a_s_ModStruct), 2)

    Local $l_i_StructLen = StringLen($a_s_ModStruct)
    Local $l_m_Seen[]

    If $l_i_StructLen > 0 And Mod($l_i_StructLen, 8) = 0 Then
        For $i = 0 To ($l_i_StructLen / 8) - 1
            Local $l_s_Token = StringMid($a_s_ModStruct, $i * 8 + 1, 8)
            If MapExists($g_m_AllMods, $l_s_Token) And Not MapExists($l_m_Seen, $l_s_Token) Then
                $l_m_Seen[$l_s_Token] = True
                ReDim $l_as_Mods[UBound($l_as_Mods) + 1]
                $l_as_Mods[UBound($l_as_Mods) - 1] = $l_s_Token
            EndIf
        Next
        If UBound($l_as_Mods) > 0 Then Return $l_as_Mods
    EndIf

    If $g_s_AllModsRegex <> "" Then
        Local $l_as_Matches = StringRegExp($a_s_ModStruct, $g_s_AllModsRegex, 3)
        If Not @error And IsArray($l_as_Matches) Then
            Local $l_m_Seen2[], $l_as_Result[0]
            For $i = 0 To UBound($l_as_Matches) - 1
                Local $l_s_Token = $l_as_Matches[$i]
                If Not MapExists($l_m_Seen2, $l_s_Token) Then
                    $l_m_Seen2[$l_s_Token] = True
                    ReDim $l_as_Result[UBound($l_as_Result) + 1]
                    $l_as_Result[UBound($l_as_Result) - 1] = $l_s_Token
                EndIf
            Next
            Return $l_as_Result
        EndIf
    EndIf

    Return $l_as_Mods
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_ArrayToSet
; Description....: Converts an array of (already normalized) tokens into a set for O(1) membership checks.
; Syntax.........: ItemFilter_ArrayToSet ( $a_as_Mods )
; Parameters.....: $a_as_Mods        - 1D array of normalized tokens.
; Return values..: Success           - Map (token → True).
; Author.........: KleuTSchi
; Remarks........: Keeps the hot path (membership) constant-time during entry matching.
; Related........: ItemFilter_EntryMatch, ItemFilter_ParseModsFromStruct
; ===============================================================================================================================
Func ItemFilter_ArrayToSet($a_as_Mods)
    Local $l_m_Set[]
    For $i = 0 To UBound($a_as_Mods) - 1
        $l_m_Set[$a_as_Mods[$i]] = True
    Next
    Return $l_m_Set
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_EntryMatch
; Description....: Checks whether an item’s token set satisfies one entry’s constraints: all Pos present, no Neg present.
; Syntax.........: ItemFilter_EntryMatch ( $a_m_ItemSet, $a_as_Entry )
; Parameters.....: $a_m_ItemSet      - Map (set) of item tokens: token → True.
;                  $a_as_Entry       - Entry array: [Pos[], Neg[]].
; Return values..: Success           - True if all Pos ∈ set AND none of Neg ∈ set; otherwise False.
; Author.........: KleuTSchi
; Remarks........: Tokens must be normalized before constructing $a_m_ItemSet.
; Related........: ItemFilter_ArrayToSet, ItemFilter_AnyEntryMatch
; ===============================================================================================================================
Func ItemFilter_EntryMatch($a_m_ItemSet, $a_as_Entry)
    Local $l_as_Pos = $a_as_Entry[0]
    Local $l_as_Neg = $a_as_Entry[1]

    For $i = 0 To UBound($l_as_Pos) - 1
        If Not MapExists($a_m_ItemSet, $l_as_Pos[$i]) Then Return False
    Next
    For $i = 0 To UBound($l_as_Neg) - 1
        If MapExists($a_m_ItemSet, $l_as_Neg[$i]) Then Return False
    Next
    Return True
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_AnyEntryMatch
; Description....: Returns True if any entry in an entry-array matches the provided item token set.
; Syntax.........: ItemFilter_AnyEntryMatch ( $a_m_ItemSet, $a_as_Entries )
; Parameters.....: $a_m_ItemSet      - Map (set) of item tokens: token → True.
;                  $a_as_Entries     - Array of entries: [ [Pos[],Neg[]], ... ].
; Return values..: Success           - True if at least one entry matches; otherwise False.
; Author.........: KleuTSchi
; Remarks........: Linear scan; typically small arrays so simpler than building indices.
; Related........: ItemFilter_EntryMatch
; ===============================================================================================================================
Func ItemFilter_AnyEntryMatch($a_m_ItemSet, $a_as_Entries)
    For $i = 0 To UBound($a_as_Entries) - 1
        If ItemFilter_EntryMatch($a_m_ItemSet, $a_as_Entries[$i]) Then Return True
    Next
    Return False
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_HasPerfectMods
; Description....: High-level predicate: checks if an item matches any configured “perfect” pattern for its weapon family.
; Syntax.........: ItemFilter_HasPerfectMods ( $a_p_Item [, $a_i_Type = -1 ] )
; Parameters.....: $a_p_Item         - Pointer to item struct (0 is invalid).
;                  $a_i_Type         - Optional weapon type byte; when -1 it is read from the item.
; Return values..: Success           - True/False depending on whether a pattern matches.
;                  Failure           - False with @error set:
;                                      @error = 1 → invalid item pointer
;                                      @error = 2 → unknown/unsupported type
; Author.........: KleuTSchi
; Remarks........: - Parses ModStruct → tokens → set, then routes to entries by family:
;                    * Martial: $g_as_MartialEntries (array of entries)
;                    * Shield : $g_as_ShieldEntries
;                    * Staff  : $g_m_StaffEntriesByAttr[attr]
;                    * Caster : $g_m_CasterEntriesByAttr[attr]
;                  - Call ItemFilter_InitPatterns() once at startup.
; Related........: ItemFilter_InitPatterns, ItemFilter_ParseModsFromStruct, ItemFilter_ArrayToSet,
;                  ItemFilter_AnyEntryMatch, Item_GetModStruct, Item_GetItemAttribute
; ===============================================================================================================================
Func ItemFilter_HasPerfectMods($a_p_Item, $a_i_Type = -1)
    If $a_p_Item = 0 Then Return SetError(1, 0, False)
    If $a_i_Type = -1 Then $a_i_Type = Memory_Read($a_p_Item + 0x20, "byte")

    Local $l_as_Mods = ItemFilter_ParseModsFromStruct(Item_GetModStruct($a_p_Item))
    Local $l_m_Item = ItemFilter_ArrayToSet($l_as_Mods)

    Switch $a_i_Type
        Case $GC_I_TYPE_AXE, $GC_I_TYPE_BOW, $GC_I_TYPE_HAMMER, $GC_I_TYPE_SWORD, $GC_I_TYPE_DAGGERS, $GC_I_TYPE_SCYTHE, $GC_I_TYPE_SPEAR
            Return ItemFilter_AnyEntryMatch($l_m_Item, $g_as_MartialEntries)

        Case $GC_I_TYPE_SHIELD
            Return ItemFilter_AnyEntryMatch($l_m_Item, $g_as_ShieldEntries)

        Case $GC_I_TYPE_STAFF
            Local $l_i_Attr = Item_GetItemAttribute($a_p_Item)
            If Not MapExists($g_m_StaffEntriesByAttr, $l_i_Attr) Then Return False
            Return ItemFilter_AnyEntryMatch($l_m_Item, $g_m_StaffEntriesByAttr[$l_i_Attr])

        Case $GC_I_TYPE_OFFHAND, $GC_I_TYPE_WAND
            Local $l_i_Attr = Item_GetItemAttribute($a_p_Item)
            If Not MapExists($g_m_CasterEntriesByAttr, $l_i_Attr) Then Return False
            Return ItemFilter_AnyEntryMatch($l_m_Item, $g_m_CasterEntriesByAttr[$l_i_Attr])

        Case Else
            Return SetError(2, 0, False)
    EndSwitch
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_IsCommonMaterial
; Description....: Membership test for common materials by ModelID using a packed array whose first element stores the count.
; Syntax.........: ItemFilter_IsCommonMaterial ( $a_i_ModelID )
; Parameters.....: $a_i_ModelID      - Material ModelID to test.
; Return values..: Success           - True if $a_i_ModelID is listed in $GC_AI_COMMON_MATERIALS, otherwise False.
; Author.........: KleuTSchi
; Remarks........: Expects $GC_AI_COMMON_MATERIALS to be a 1D array where index 0 contains the logical length
;                  and indices 1..N contain ModelIDs.
; Related........: ItemFilter_IsRareMaterial
; ===============================================================================================================================
Func ItemFilter_IsCommonMaterial($a_i_ModelID)
    For $i = 1 To $GC_AI_COMMON_MATERIALS[0]
        If $GC_AI_COMMON_MATERIALS[$i] = $a_i_ModelID Then
            Return True
        EndIf
    Next
    Return False
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_IsRareMaterial
; Description....: Membership test for rare materials by ModelID using a packed array whose first element stores the count.
; Syntax.........: ItemFilter_IsRareMaterial ( $a_i_ModelID )
; Parameters.....: $a_i_ModelID      - Material ModelID to test.
; Return values..: Success           - True if $a_i_ModelID is listed in $GC_AI_RARE_MATERIALS, otherwise False.
; Author.........: KleuTSchi
; Remarks........: Expects $GC_AI_RARE_MATERIALS to be a 1D array where index 0 contains the logical length
;                  and indices 1..N contain ModelIDs.
; Related........: ItemFilter_IsCommonMaterial
; ===============================================================================================================================
Func ItemFilter_IsRareMaterial($a_i_ModelID)
	For $i = 1 To $GC_AI_RARE_MATERIALS[0]
        If $GC_AI_RARE_MATERIALS[$i] = $a_i_ModelID Then
            Return True
        EndIf
    Next
    Return False
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_IsRegularTome
; Description....: Checks whether a ModelID corresponds to a regular (non-elite) profession tome.
; Syntax.........: ItemFilter_IsRegularTome ( $a_i_ModelID )
; Parameters.....: $a_i_ModelID      - Tome ModelID to test.
; Return values..: Success           - True if present in $GC_AI_TOMES_NORMALS, otherwise False.
; Author.........: KleuTSchi
; Remarks........: Expects $GC_AI_TOMES_NORMALS to store the count at index 0 followed by ModelIDs.
; Related........: ItemFilter_IsEliteTome
; ===============================================================================================================================
Func ItemFilter_IsRegularTome($a_i_ModelID)
	For $i = 1 To $GC_AI_NORMAL_TOMES[0]
        If $GC_AI_NORMAL_TOMES[$i] = $a_i_ModelID Then
            Return True
        EndIf
    Next
    Return False
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_IsEliteTome
; Description....: Checks whether a ModelID corresponds to an elite profession tome.
; Syntax.........: ItemFilter_IsEliteTome ( $a_i_ModelID )
; Parameters.....: $a_i_ModelID      - Tome ModelID to test.
; Return values..: Success           - True if present in $GC_AI_TOMES_ELITES, otherwise False.
; Author.........: KleuTSchi
; Remarks........: Expects $GC_AI_TOMES_ELITES to store the count at index 0 followed by ModelIDs.
; Related........: ItemFilter_IsRegularTome
; ===============================================================================================================================
Func ItemFilter_IsEliteTome($a_i_ModelID)
	For $i = 1 To $GC_AI_ELITE_TOMES[0]
        If $GC_AI_ELITE_TOMES[$i] = $a_i_ModelID Then
            Return True
        EndIf
    Next
    Return False
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_IsMaxReq7
; Description....: Verifies that an item is requirement 7 AND at its family-specific max stat (e.g., 21 sword, 15 shield, 11 offhand).
; Syntax.........: ItemFilter_IsMaxReq7 ( $a_p_Item [, $a_i_Type = -1 ] )
; Parameters.....: $a_p_Item         - Pointer to item struct (0 is invalid).
;                  $a_i_Type         - Optional weapon type byte; when -1 it is read from the item (offset +0x20).
; Return values..: Success           - True if req = 7 and max stat matches the weapon family; otherwise False.
;                  Failure           - False with @error set:
;                                      @error = 1 → invalid item pointer
; Author.........: KleuTSchi
; Remarks........: Uses Item_GetItemMaxDmg() and Item_GetItemReq() for the checks. Only OFFHAND, SHIELD, and SWORD are
;                  recognized here; unknown families return False.
; Related........: ItemFilter_IsMaxReq8, Item_GetItemMaxDmg, Item_GetItemReq
; ===============================================================================================================================
Func ItemFilter_IsMaxReq7($a_p_Item, $a_i_Type = -1)
    If $a_p_Item = 0 Then Return SetError(1, 0, False)
    If $a_i_Type = -1 Then $a_i_Type = Memory_Read($a_p_Item + 0x20, "byte")

	Local $l_i_Dmg = Item_GetItemMaxDmg($a_p_Item)
	Local $l_i_Req = Item_GetItemReq($a_p_Item)

	If $l_i_Req <> 7 Then Return False

	Switch $a_i_Type
		Case $GC_I_TYPE_OFFHAND
			Return ($l_i_Dmg = 11)
		Case $GC_I_TYPE_SHIELD
			Return ($l_i_Dmg = 15)
		Case $GC_I_TYPE_SWORD
			Return ($l_i_Dmg = 21)
	EndSwitch
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_IsMaxReq8
; Description....: Verifies that an item is requirement 8 AND at its family-specific max stat (e.g., 22 sword, 16 shield, 12 offhand).
; Syntax.........: ItemFilter_IsMaxReq8 ( $a_p_Item [, $a_i_Type = -1 ] )
; Parameters.....: $a_p_Item         - Pointer to item struct (0 is invalid).
;                  $a_i_Type         - Optional weapon type byte; when -1 it is read from the item (offset +0x20).
; Return values..: Success           - True if req = 8 and max stat matches the weapon family; otherwise False.
;                  Failure           - False with @error set:
;                                      @error = 1 → invalid item pointer
; Author.........: KleuTSchi
; Remarks........: Uses Item_GetItemMaxDmg() and Item_GetItemReq(). Only OFFHAND, SHIELD, and SWORD are recognized here;
;                  unknown families return False.
; Related........: ItemFilter_IsMaxReq7, Item_GetItemMaxDmg, Item_GetItemReq
; ==============================================================================================================================
Func ItemFilter_IsMaxReq8($a_p_Item, $a_i_Type = -1)
    If $a_p_Item = 0 Then Return SetError(1, 0, False)
    If $a_i_Type = -1 Then $a_i_Type = Memory_Read($a_p_Item + 0x20, "byte")

	Local $l_i_Dmg = Item_GetItemMaxDmg($a_p_Item)
	Local $l_i_Req = Item_GetItemReq($a_p_Item)

	If $l_i_Req <> 8 Then Return False

	Switch $a_i_Type
		Case $GC_I_TYPE_OFFHAND
			Return ($l_i_Dmg = 12)
		Case $GC_I_TYPE_SHIELD
			Return ($l_i_Dmg = 16)
		Case $GC_I_TYPE_SWORD
			Return ($l_i_Dmg = 22)
	EndSwitch
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_IsRareRune
; Description....: Detects whether an item’s ModStruct contains any configured “rare” rune/insignia token.
; Syntax.........: ItemFilter_IsRareRune ( $a_p_Item )
; Parameters.....: $a_p_Item         - Pointer to item struct.
; Return values..: Success           - True if any rare token is present; otherwise False.
;                  Failure           - False with @error set:
;                                      @error = 1 → invalid item pointer
; Author.........: KleuTSchi
; Remarks........: - Caches a token set (map) on first use. Tokens are 8-hex, normalized via ItemFilter_NormalizeMod().
;                  - Fast path: if ModStruct length is a multiple of 8, scans fixed 8-hex chunks.
;                  - Fallback: uses ItemFilter_ParseModsFromStruct() for regex-based extraction on odd payloads.
; Related........: Item_GetModStruct, ItemFilter_ParseModsFromStruct, ItemFilter_NormalizeMod, ItemFilter_ArrayToSet
; ===============================================================================================================================
Func ItemFilter_IsRareRune($a_p_Item)
	If $a_p_Item = 0 Then Return SetError(1, 0, False)
    Local $l_s_ModStruct = Item_GetModStruct($a_p_Item)

    Static $s_m_RareRunes[], $s_b_Init = False
    If Not $s_b_Init Then
        Local $l_as_RareRunes = [ _
            $GC_S_INSIGNIA_MESMER_PRODIGY, _
            $GC_S_RUNE_MESMER_SUPERIOR_DOMINATION_MAGIC, _
            $GC_S_INSIGNIA_RITUALIST_SHAMAN, _
            $GC_S_RUNE_PARAGON_MINOR_SPEAR_MASTERY, _
            $GC_S_RUNE_PARAGON_MINOR_LEADERSHIP, _
            $GC_S_INSIGNIA_DERVISH_WINDWALKER, _
            $GC_S_RUNE_DERVISH_MINOR_SCYTHE_MASTERY, _
            $GC_S_RUNE_DERVISH_MINOR_MYSTICISM, _
            $GC_S_RUNE_GENERAL_MAJOR_VIGOR, _
            $GC_S_RUNE_GENERAL_SUPERIOR_VIGOR _
        ]
        For $i = 0 To UBound($l_as_RareRunes) - 1
            $s_m_RareRunes[ItemFilter_NormalizeMod($l_as_RareRunes[$i])] = True
        Next
        $s_b_Init = True
    EndIf

    $l_s_ModStruct = ItemFilter_NormalizeMod($l_s_ModStruct)
    If StringLeft($l_s_ModStruct, 2) = "0X" Then $l_s_ModStruct = StringTrimLeft($l_s_ModStruct, 2)
    Local $l_i_Len = StringLen($l_s_ModStruct)

    If Mod($l_i_Len, 8) = 0 Then
        For $i = 0 To ($l_i_Len / 8) - 1
            Local $tok = StringMid($l_s_ModStruct, $i * 8 + 1, 8)
            If MapExists($s_m_RareRunes, $tok) Then Return True
        Next
        Return False
    EndIf

    Local $l_as_Mods = ItemFilter_ParseModsFromStruct($l_s_ModStruct) ; already normalizes & dedupes
    For $i = 0 To UBound($l_as_Mods) - 1
        If MapExists($s_m_RareRunes, $l_as_Mods[$i]) Then Return True
    Next
    Return False
EndFunc

; #FUNCTION# ====================================================================================================================
; Name...........: ItemFilter_IsRareSkin
; Description....: Determines whether a given ModelID belongs to a curated set of “rare skin” IDs.
; Syntax.........: ItemFilter_IsRareSkin ( $a_i_ModelID )
